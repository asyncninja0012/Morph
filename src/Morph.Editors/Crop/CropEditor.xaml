<UserControl x:Class="Morph.Editors.Crop.CropEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Morph.Editors"
             Focusable="True" IsTabStop="False">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="SizeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                       AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <local:ChipGroup x:Name="Aspects" Orientation="Horizontal" AutomationProperties.Name="Shape" KeyboardNavigation.DirectionalNavigation="Cycle" />
        </DockPanel>
        <local:SurfaceGrid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Cursor="Cross" Background="Transparent"
              Focusable="True" AutomationProperties.Name="Crop box. Arrow keys move it, Shift with arrow keys resizes it.">
            <Image x:Name="Picture" Stretch="Fill" />
            <Path x:Name="Shade" Fill="#8C000000" IsHitTestVisible="False" />
            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Rectangle x:Name="Frame" Stroke="White" StrokeThickness="1.5" />
            </Canvas>
        </local:SurfaceGrid>
    </DockPanel>
</UserControl>
