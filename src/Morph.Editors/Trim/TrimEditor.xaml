<UserControl x:Class="Morph.Editors.Trim.TrimEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="False" FocusVisualStyle="{x:Null}">
    <StackPanel x:Name="Root">
        <!-- The player shows only the Worker's Morph-made copy (PlaybackLoader), never the dropped file. -->
        <Grid x:Name="Screen" Background="Black" HorizontalAlignment="Center" Margin="0,0,0,10">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" />
            <TextBlock x:Name="ScreenText" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="16" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Grid x:Name="Timeline" Height="64" Background="#40000000" ClipToBounds="True" Cursor="Hand" Focusable="True" HorizontalAlignment="Center"
              AutomationProperties.Name="Timeline. Space plays, arrow keys move the playhead, I sets the start, O the end, S splits, Delete removes the nearest split.">
            <Image x:Name="Strip" Stretch="Fill" />
            <Canvas x:Name="Marks" IsHitTestVisible="False" />
        </Grid>
        <DockPanel Margin="0,8,0,0">
            <Button x:Name="PlayButton" Content="Play" ToolTip="Space" MinWidth="72" IsEnabled="False" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="InButton" Content="Start here" ToolTip="I" Margin="0,0,4,0" />
                <Button x:Name="SplitButton" Content="Split here" ToolTip="S" Margin="0,0,4,0" />
                <Button x:Name="OutButton" Content="End here" ToolTip="O" />
            </StackPanel>
            <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
        <StackPanel x:Name="Modes" Orientation="Horizontal" Margin="0,10,0,0" AutomationProperties.Name="Cut" KeyboardNavigation.DirectionalNavigation="Cycle" />
        <TextBlock x:Name="ModeHint" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="Summary" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
