<UserControl x:Class="Morph.Editors.Speed.SpeedEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="False" FocusVisualStyle="{x:Null}">
    <StackPanel>
        <!-- The player shows only the Worker's Morph-made copy (PlaybackLoader), never the dropped file. -->
        <Grid x:Name="Screen" Background="Black" HorizontalAlignment="Center" Margin="0,0,0,10">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" />
            <TextBlock x:Name="ScreenText" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="16" AutomationProperties.LiveSetting="Polite" />
        </Grid>
        <Slider x:Name="Position" Minimum="0" Maximum="1" SmallChange="1" LargeChange="5" IsEnabled="False"
                AutomationProperties.Name="Position. Arrow keys move 1 second." />
        <DockPanel Margin="0,6,0,0">
            <Button x:Name="PlayButton" Content="Play" ToolTip="Space" MinWidth="72" IsEnabled="False" />
            <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="12,0" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
        <TextBlock x:Name="SpeedLabel" Text="Speed" FontWeight="SemiBold" Margin="0,14,0,4" />
        <DockPanel>
            <TextBlock x:Name="SpeedText" DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right" VerticalAlignment="Center" FontSize="16"
                       FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Slider x:Name="SpeedSlider" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" TickFrequency="1" TickPlacement="BottomRight"
                    IsSnapToTickEnabled="True" AutomationProperties.LabeledBy="{Binding ElementName=SpeedLabel}" />
        </DockPanel>
        <Canvas x:Name="Ticks" Height="18" Margin="0,2,52,0" />
        <TextBlock x:Name="Summary" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="Hint" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="The sound keeps its pitch. Space plays; + and − change the speed." />
    </StackPanel>
</UserControl>
