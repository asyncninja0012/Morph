<Window x:Class="Morph.Editors.EditorShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="440" MinHeight="240"
        ThemeMode="System" WindowStartupLocation="CenterScreen" Topmost="True" Background="Transparent">
    <!-- Morph glass (MorphTheme): a warm tint over the Windows acrylic backdrop. -->
    <Border Background="{DynamicResource MorphSurfaceBrush}" Padding="20,12,20,20">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel x:Name="ModePanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed"
                            AutomationProperties.Name="Several files">
                    <RadioButton x:Name="AllButton" Content="Same for all" Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="96" Margin="0,0,4,0" IsChecked="True" />
                    <RadioButton x:Name="StepButton" Content="One by one" Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="96" />
                </StackPanel>
                <TextBlock x:Name="FileText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </DockPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button x:Name="UndoButton" Content="Undo" ToolTip="Ctrl+Z" MinWidth="96" IsEnabled="False" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <Button x:Name="DoneButton" Content="Done" IsDefault="True" IsEnabled="False" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </DockPanel>

            <Grid>
                <ContentPresenter x:Name="EditorHost" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
