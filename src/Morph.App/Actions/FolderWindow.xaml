<Window x:Class="Morph.App.Actions.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy to" Width="420" SizeToContent="Height"
        ThemeMode="System" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" Background="Transparent">
    <!-- Morph glass (MorphTheme): a warm tint over the Windows acrylic backdrop. -->
    <Border Background="{DynamicResource MorphSurfaceBrush}" Padding="20,12,20,20">
        <StackPanel>
            <TextBlock x:Name="FilesText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="RecentLabel" Text="Recent folders" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel x:Name="Recent" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.LabeledBy="{Binding ElementName=RecentLabel}" />
            <Button x:Name="ChooseButton" Content="Choose a folder…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
