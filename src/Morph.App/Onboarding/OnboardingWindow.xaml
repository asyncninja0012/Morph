<Window x:Class="Morph.App.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Morph" Width="680" SizeToContent="Height"
        ThemeMode="System" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="Transparent">
    <!-- Morph glass (MorphTheme): a warm tint over the Windows acrylic backdrop. -->
    <Border Background="{DynamicResource MorphSurfaceBrush}" Padding="24,16,24,20">
        <StackPanel>
            <!-- Page 1: the demo. -->
            <StackPanel x:Name="DemoPage">
                <TextBlock Text="Try it: turn this picture into a PNG" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Tile" Width="240" Height="160" CornerRadius="8" BorderThickness="2" Cursor="Hand"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="Drag me"
                            AutomationProperties.Name="Sample picture: drag it" Focusable="True">
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Image x:Name="SampleImage" Stretch="UniformToFill" />
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step1" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="Step2" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="Step3" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,20,0,0" MinHeight="40"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink x:Name="ShowLink">Open the picture's folder</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Page 2: the other ways in. -->
            <StackPanel x:Name="MorePage" Visibility="Collapsed">
                <TextBlock Text="More ways in" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ToolsText" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ActionsText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="No mouse? Select files in File Explorer and press Alt+Shift+Space: arrows pick, Enter runs, Tab switches wheels." />
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="The Morph icon in the taskbar's corner has your recent jobs (with Undo for 10 minutes), the Float shelf and Settings, where you can change the keys." />
            </StackPanel>

            <Grid Margin="0,24,0,0">
                <Button x:Name="SkipButton" Content="Skip" MinWidth="96" HorizontalAlignment="Left" />
                <Button x:Name="NextButton" Content="Next" MinWidth="96" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
