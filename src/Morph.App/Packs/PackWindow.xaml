<Window x:Class="Morph.App.Packs.PackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download" Width="420" SizeToContent="Height"
        ThemeMode="System" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" Background="Transparent">
    <!-- Morph glass (MorphTheme): a warm tint over the Windows acrylic backdrop. -->
    <Border Background="{DynamicResource MorphSurfaceBrush}" Padding="20,12,20,20">
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SizeText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,10,0,0">
                <Hyperlink x:Name="LicenceLink">Licence</Hyperlink>
            </TextBlock>

            <ProgressBar x:Name="Bar" Height="4" Margin="0,16,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button x:Name="DownloadButton" Content="Download" IsDefault="True" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
