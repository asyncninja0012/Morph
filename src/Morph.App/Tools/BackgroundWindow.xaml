<Window x:Class="Morph.App.Tools.BackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove background" Width="560" SizeToContent="Height"
        ThemeMode="System" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" Background="Transparent">
    <!-- Morph glass (MorphTheme): a warm tint over the Windows acrylic backdrop. -->
    <Border Background="{DynamicResource MorphSurfaceBrush}" Padding="20,12,20,20">
        <StackPanel>
            <TextBlock x:Name="NameText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- A checkerboard shows which parts are now see-through. -->
            <Border Height="400" Margin="0,12,0,0" CornerRadius="6" ClipToBounds="True">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                                <GeometryDrawing Brush="#D8D8D8" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Grid>
                    <Image x:Name="Picture" Stretch="Uniform" Margin="8" AutomationProperties.Name="Cut-out preview" />
                    <ProgressBar x:Name="Loading" IsIndeterminate="True" Width="160" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />

            <Grid Margin="0,20,0,0">
                <StackPanel x:Name="Paging" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="PreviousButton" Content="&#xE76B;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Previous picture" MinWidth="40" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Button x:Name="NextButton" Content="&#xE76C;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Next picture" MinWidth="40" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DiscardButton" Content="Discard" MinWidth="96" Margin="0,0,8,0" />
                    <Button x:Name="KeepButton" Content="Keep" IsDefault="True" IsCancel="True" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
