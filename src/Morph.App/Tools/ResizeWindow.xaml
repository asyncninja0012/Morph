<Window x:Class="Morph.App.Tools.ResizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize" Width="460" SizeToContent="Height"
        ThemeMode="System" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" Background="Transparent">
    <!-- Morph glass (MorphTheme): a warm tint over the Windows acrylic backdrop. -->
    <Border Background="{DynamicResource MorphSurfaceBrush}" Padding="20,12,20,20">
        <StackPanel>
            <TextBlock x:Name="FilesText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Changes the width and height in pixels. Fewer pixels also make a smaller file." TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock x:Name="SizeLabel" Text="New size" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel x:Name="Sizes" Orientation="Horizontal" AutomationProperties.LabeledBy="{Binding ElementName=SizeLabel}">
                <RadioButton Tag="half" Content="50%" Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="70" Margin="0,0,4,0" IsChecked="True" />
                <RadioButton Tag="1080p" Content="1080p" Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="70" Margin="0,0,4,0" />
                <RadioButton Tag="720p" Content="720p" Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="70" Margin="0,0,4,0" />
                <RadioButton Tag="2048" Content="2048 px" Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="70" Margin="0,0,4,0" />
                <RadioButton x:Name="CustomButton" Tag="custom" Content="Custom" Style="{DynamicResource {x:Type ToggleButton}}" MinWidth="70" />
            </StackPanel>
            <TextBlock x:Name="SizeHint" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel x:Name="CustomPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="WidthBox" Width="90" AutomationProperties.Name="Width in pixels" />
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBox x:Name="HeightBox" Width="90" AutomationProperties.Name="Height in pixels" />
                    <TextBlock Text="px" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <CheckBox x:Name="KeepRatio" Content="Keep aspect ratio" IsChecked="True" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button x:Name="RunButton" Content="Resize" IsDefault="True" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
