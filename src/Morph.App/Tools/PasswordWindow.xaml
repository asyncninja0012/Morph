<Window x:Class="Morph.App.Tools.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protect" Width="400" SizeToContent="Height"
        ThemeMode="System" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" Background="Transparent">
    <!-- Morph glass (MorphTheme): a warm tint over the Windows acrylic backdrop. -->
    <Border Background="{DynamicResource MorphSurfaceBrush}" Padding="20,12,20,20">
        <StackPanel>
            <TextBlock x:Name="FilesText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock x:Name="PasswordLabel" Text="Password" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <Grid>
                <PasswordBox x:Name="Hidden" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
                <TextBox x:Name="Shown" Visibility="Collapsed" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
            </Grid>
            <CheckBox x:Name="ShowBox" Content="Show password" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button x:Name="RunButton" Content="Protect" IsDefault="True" IsEnabled="False" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
