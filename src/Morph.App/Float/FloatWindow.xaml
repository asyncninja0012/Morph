<Window x:Class="Morph.App.Float.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Float" Width="260" SizeToContent="Height"
        ThemeMode="System" WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowDrop="True">
    <!-- Morph glass (MorphTheme), like the toasts: never active, so blur-behind rather than the system backdrop. -->
    <Border x:Name="Frame" Padding="10,8,6,10" Background="{DynamicResource MorphSurfaceBrush}" BorderThickness="2" BorderBrush="Transparent">
        <StackPanel>
            <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move the shelf">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Float" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Button x:Name="ClearButton" Grid.Column="1" Content="Clear all" Padding="8,2" Margin="0,0,4,0" Cursor="Arrow"
                        Background="Transparent" BorderThickness="0" FontSize="12" />
                <Button x:Name="HideButton" Grid.Column="2" Padding="6,2" Cursor="Arrow" Background="Transparent" BorderThickness="0"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Content="&#xE8BB;"
                        ToolTip="Hide the shelf (it keeps its files; open it again from the tray)" AutomationProperties.Name="Hide the shelf" />
            </Grid>
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="2,10,6,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Drop files or folders here to park them, then drag them out to any app or folder." />
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                <StackPanel x:Name="Items" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
