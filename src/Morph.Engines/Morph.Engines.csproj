<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- PDFium interop: text buffers and bitmap pointers -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morph.Core\Morph.Core.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Magick.NET-Q8-x64" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <!-- A Dispatcher and a hidden HwndSource host WebView2 for HTML -> PDF; WPF ships with the App anyway. Not UseWPF: it drops the System.IO using. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="SharpZipLib" /> <!-- AES-256 ZIP write and read (D5); System.IO.Compression can't encrypt -->
    <InternalsVisibleTo Include="Morph.Engines.Tests" />
  </ItemGroup>

  <!-- Fetched by build/fetch-binaries.ps1; flows to the Worker, App and test output folders. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\binaries\ffmpeg.exe;$(MSBuildThisFileDirectory)..\..\artifacts\binaries\ffprobe.exe"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\binaries\ffmpeg.exe')"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\binaries\pdfium.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\binaries\pdfium.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
