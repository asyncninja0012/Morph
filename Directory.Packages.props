<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Build-time">
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
  </ItemGroup>
  <ItemGroup Label="App">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Engines">
    <PackageVersion Include="Magick.NET-Q8-x64" Version="14.17.2" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- Pinned above PDFsharp's 8.0.1 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); only its signing code uses it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
